{
  "name": "rx-queue",
  "version": "2.0.0",
  "description": "Easy to Use ReactiveX Queue that Supports Delay/DelayExecutor/Throttle/Debounce/Concurrency Features Powered by RxJS/IxJS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js",
      "default": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests scripts",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:unit:deno": "deno test --no-check --allow-read --allow-env src",
    "test:pack": "bash -x scripts/npm-pack-testing.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/rx-queue.git"
  },
  "keywords": [
    "queue",
    "delay",
    "executor",
    "throttle",
    "debounce",
    "rxjs",
    "rx",
    "fifo"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/rx-queue/issues"
  },
  "homepage": "https://github.com/huan/rx-queue#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "ix": "^4.5.2",
    "rxjs": "^7.8.1"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
